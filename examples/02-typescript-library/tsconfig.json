{
  "extends": "lavy/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "swiftlet.config.ts"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
